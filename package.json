{
  "name": "mcp-unison",
  "displayName": "MCP Unison",
  "description": "Use the MCP servers you registered in Claude Code or Codex from VS Code chat (Copilot) without copying them by hand.",
  "version": "0.1.3",
  "publisher": "leegyeongpil",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LeeGyeongPil/mcp-unison.git"
  },
  "homepage": "https://github.com/LeeGyeongPil/mcp-unison#readme",
  "bugs": "https://github.com/LeeGyeongPil/mcp-unison/issues",
  "keywords": ["mcp", "vscode", "copilot", "claude-code", "codex", "sync"],
  "categories": ["AI", "Other"],
  "engines": {
    "vscode": "^1.101.0",
    "node": ">=20"
  },
  "main": "./out/src/extension.js",
  "bin": {
    "mcp-unison": "out/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p .",
    "test": "tsc -p . && node --test \"out/test/**/*.test.js\"",
    "start": "tsc -p . && node out/src/cli.js diff --demo",
    "package": "tsc -p . && vsce package --no-yarn",
    "test:integration": "tsc -p . && node out/test/integration/run.js"
  },
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "mcpUnison.servers",
        "label": "MCP Unison"
      }
    ],
    "commands": [
      { "command": "mcpUnison.refresh", "title": "%command.refresh%", "category": "MCP Unison" },
      { "command": "mcpUnison.syncCopilot", "title": "%command.syncCopilot%", "category": "MCP Unison" },
      { "command": "mcpUnison.showDrift", "title": "%command.showDrift%", "category": "MCP Unison" },
      { "command": "mcpUnison.exportClaude", "title": "%command.exportClaude%", "category": "MCP Unison" },
      { "command": "mcpUnison.showInCopilotSessions", "title": "%command.showInCopilotSessions%", "category": "MCP Unison" },
      { "command": "mcpUnison.chooseLanguage", "title": "%command.chooseLanguage%", "category": "MCP Unison" }
    ],
    "configuration": {
      "title": "MCP Unison",
      "properties": {
        "mcpUnison.sources.claude": {
          "type": "boolean",
          "default": true,
          "description": "%config.sources.claude%"
        },
        "mcpUnison.sources.codex": {
          "type": "boolean",
          "default": true,
          "description": "%config.sources.codex%"
        },
        "mcpUnison.copilotSync": {
          "type": "string",
          "enum": ["off", "ask", "auto"],
          "default": "ask",
          "description": "%config.copilotSync%"
        },
        "mcpUnison.blockedRemoteVars": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "%config.blockedRemoteVars%"
        },
        "mcpUnison.language": {
          "type": "string",
          "enum": ["auto", "en", "ko"],
          "default": "auto",
          "description": "%config.language%"
        }
      }
    }
  },
  "dependencies": {
    "jsonc-parser": "3.3.1",
    "smol-toml": "1.9.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/vscode": "1.101.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.1",
    "typescript": "7.0.2"
  }
}
